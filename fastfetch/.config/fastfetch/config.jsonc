{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/smug.txt",
    "padding": {
      "top": 1,
    },
  },
  "display": {
    "separator": "    ",
  },
  "modules": [
    "break",
    "title",
    {
      "type": "os",
      "key": "os    ",
      "keyColor": "33",
    },
    {
      "type": "kernel",
      "key": "kernel",
      "keyColor": "33",
    },
    {
      "type": "host",
      "format": "{5} {1}",
      "key": "host  ",
      "keyColor": "33",
    },
    {
      "type": "shell",
      "format": "{pretty-name} {version}",
      "key": "shell ",
      "keyColor": "33",
    },
    {
      "type": "packages",
      "format": "{} (dpkg)",
      "key": "pkgs  ",
      "keyColor": "33",
    },
    {
      "type": "cpu",
      "format": "{name} ({cores-physical}C/{cores-logical}T) @ {freq-max}",
      "key": "cpu   ",
      "keyColor": "33",
    },
    {
      "type": "memory",
      "key": "memory",
      "keyColor": "33",
    },
    {
      "type": "disk",
      "key": "disk  ",
      "keyColor": "33",
    },
    "break",
  ],
}
